{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "django",
      "buildCommand": "python manage.py migrate --noinput && python manage.py bootstrap && python manage.py collectstatic --noinput"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/django-admin/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/static/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/media/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
