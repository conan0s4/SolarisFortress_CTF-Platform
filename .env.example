# SolarisFortress CTF Platform - Environment Configuration
# Copy this file to .env and fill in real values.
# DO NOT commit real credentials.

# Django
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=solarisfortress
DB_USER=solaris
DB_PASSWORD=solaris
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend (used by Django to allow CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Set to 1 to fall back to SQLite for local development without PostgreSQL.
USE_SQLITE=1