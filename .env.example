# SolarisFortress CTF Platform - Environment Configuration
# Copy this file to .env and fill in real values.
# DO NOT commit real credentials.

# Django Security & Core
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Database Options:
# Option A (Recommended for Vercel/Production): Connection URL from Neon, Supabase, Railway, etc.
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/solarisfortress?sslmode=require

# Option B (Local fallback): Set USE_SQLITE=1 for local development without PostgreSQL
USE_SQLITE=1

# Option C: Manual PostgreSQL parameters (if not using DATABASE_URL)
DB_NAME=solarisfortress
DB_USER=solaris
DB_PASSWORD=solaris
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS & Frontend Origins (Comma-separated origins for local Vite, preview, and production domains)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Frontend environment variables (prefix with VITE_):
# Leave blank when using unified Vercel monorepo routing (/api)
# Set to full backend origin (e.g. https://solarisfortress-api.vercel.app) for decoupled deployments
VITE_API_BASE_URL=